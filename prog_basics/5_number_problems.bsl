// 1
Функция СуммаСтрокой(Сумма)
	ЦелаяЧасть = Цел(Сумма);
	ДробнаяЧасть = (Сумма - ЦелаяЧасть) * 100;
	ИтоговаяСтрока = "" + ЦелаяЧасть + " руб. " + ДробнаяЧасть + " коп.";
	Возврат ИтоговаяСтрока;
КонецФункции;  


Сумма = 127.45;
Результат = СуммаСтрокой(Сумма);
Сообщить(Результат);

