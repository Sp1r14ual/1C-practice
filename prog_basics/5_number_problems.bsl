	Если Сумма < 100 Тогда
		Результат = Окр(Сумма);
	Иначе 
		Результат = Цел(Сумма); // ?
	КонецЕсли;
	Возврат Результат;
КонецФункции

Сумма = 150.51;
Результат = НестандартноеОкругление(Сумма);
Сообщить(Результат);

