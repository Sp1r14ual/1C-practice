// 5
Функция ПолучитьМесяцСтрокой(НомерМесяца)
Перем МесяцСтрокой;
Если НомерМесяца = 1 Тогда
    МесяцСтрокой = "январь"
ИначеЕсли НомерМесяца = 2 Тогда
    МесяцСтрокой = "февраль"
ИначеЕсли НомерМесяца = 3 Тогда
    МесяцСтрокой = "март"
ИначеЕсли НомерМесяца = 4 Тогда
    МесяцСтрокой = "апрель"
ИначеЕсли НомерМесяца = 5 Тогда
    МесяцСтрокой = "май"
ИначеЕсли НомерМесяца = 6 Тогда
    МесяцСтрокой = "июнь"
ИначеЕсли НомерМесяца = 7 Тогда
    МесяцСтрокой = "июль"
ИначеЕсли НомерМесяца = 8 Тогда
    МесяцСтрокой = "август"
ИначеЕсли НомерМесяца = 9 Тогда
    МесяцСтрокой = "сентябрь"
ИначеЕсли НомерМесяца = 10 Тогда
    МесяцСтрокой = "октябрь"
ИначеЕсли НомерМесяца = 11 Тогда
    МесяцСтрокой = "ноябрь"
ИначеЕсли НомерМесяца = 12 Тогда
    МесяцСтрокой = "декабрь"
КонецЕсли;
Возврат МесяцСтрокой;
КонецФункции;

Результат = ПолучитьМесяцСтрокой(6);
Сообщить(Результат);

// 6
Функция ПолучитьНомерМесяца(НазваниеМесяца)      
Если НазваниеМесяца = "январь" Тогда
    Возврат 1;
ИначеЕсли НазваниеМесяца = "февраль" Тогда
    Возврат 2;
ИначеЕсли НазваниеМесяца = "март" Тогда
    Возврат 3;
ИначеЕсли НазваниеМесяца = "апрель" Тогда
    Возврат 4;
ИначеЕсли НазваниеМесяца = "май" Тогда
    Возврат 5;
ИначеЕсли НазваниеМесяца = "июнь" Тогда
    Возврат 6;
ИначеЕсли НазваниеМесяца = "июль" Тогда
    Возврат 7;
ИначеЕсли НазваниеМесяца = "август" Тогда
    Возврат 8;
ИначеЕсли НазваниеМесяца = "сентябрь" Тогда
    Возврат 9;
ИначеЕсли НазваниеМесяца = "октябрь" Тогда
    Возврат 10;
ИначеЕсли НазваниеМесяца = "ноябрь" Тогда
    Возврат 11;
ИначеЕсли НазваниеМесяца = "декабрь" Тогда
    Возврат 12;
Иначе
    Возврат 0;
КонецЕсли;
    
КонецФункции

Результат = ПолучитьНомерМесяца("июнь");
Сообщить(Результат);