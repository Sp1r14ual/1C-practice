// ЗАДАЧА 8
// Условие:
// Конкатенация строк с учетом преобразования типов.
// Объявите 3 переменные «Сотрудник», «ДатаРождения», «Оклад» и присвойте им следующие 
// значения соответственно: «Иванов» (тип «Строка»), «01.02.1989» (тип «Дата») и «1250» (тип «Число»).
// Используя эти переменные, необходимо сформировать строку с данными сотрудника 
// в переменной «Результат» в следующем формате:
// «01.02.1989, Иванов, 1250 руб.»
// =============================================================================

Сотрудник = "Иванов";
ДатаРождения = '19890201';
Оклад = 1250;

Результат = "" + Формат(ДатаРождения, "ДЛФ=D") + ", " + Сотрудник + ", " + Оклад + " руб.";
Сообщить(Результат);


// =============================================================================
// ЗАДАЧА 9
// Условие:
// Какое сообщение увидит пользователь в результате выполнения данного программного кода?
// Дата1 = "01.09.2020";
// Дата2 = Дата1 + 12;
// Сообщить(Дата2);
// =============================================================================

Дата1 = "01.09.2020";
Дата2 = Дата1 + 12;
Сообщить(Дата2); 
// Ответ: 01.09.202012
// Пояснение: переменная Дата1 является строкой (в двойных кавычках), 
// поэтому оператор "+" выполняет конкатенацию строк. Число 12 приводится к строке "12".


// =============================================================================
// ЗАДАЧА 10
// Условие:
// Какое сообщение увидит пользователь в результате выполнения данного программного кода?
// Дата1 = '20200901';
// Дата2 = Дата1 + 12;
// Сообщить(Дата2);
// =============================================================================

Дата1 = '20200901';
Дата2 = Дата1 + 12;
Сообщить(Дата2); 
// Ответ: 01.09.2020 00:00:12
// Пояснение: переменная Дата1 имеет тип "Дата" (литерал в одинарных кавычках). 
// В 1С сложение даты с числом прибавляет к дате указанное количество секунд (+12 секунд).


// =============================================================================
// ЗАДАЧА 11
// Условие:
// Какое сообщение увидит пользователь в результате выполнения данного программного кода?
// ТабельныйНомер = 280;
// Оклад = 400;
// ПроцентПремии = 14;
// РазмерПремии = Оклад * ПроцентПремии / 100;
// Сообщить(ТабельныйНомер + " - премия = " + РазмерПремии);
// =============================================================================

ТабельныйНомер = 280;
Оклад = 400;
ПроцентПремии = 14;
РазмерПремии = Оклад * ПроцентПремии / 100;

// Исходный вызов приводит к ошибке:
// Сообщить(ТабельныйНомер + " - премия = " + РазмерПремии); 
// Ответ: Преобразование значения к типу Число не может быть выполнено
// Пояснение: Первый операнд ТабельныйНомер — число. При сложении со строкой (" - премия = ")
// платформа 1С пытается преобразовать строку к числу, что вызывает ошибку.

// Исправленный вариант вывода (первым операндом передается строка):
Сообщить("" + ТабельныйНомер + " - премия = " + РазмерПремии);


// =============================================================================
// ЗАДАЧА 12
// Условие:
// Количество дней между датами.
// Объявите переменную «НачалоМесяца» и присвойте ей значение начала текущего месяца (тип «Дата»). 
// Объявите переменную «КонецМесяца» и присвойте ей значение окончания текущего месяца (Тип «Дата»). 
// Вычислите количество дней между началом и концом месяца и поместите результат 
// в переменную «КоличествоДней».
// =============================================================================

НачалоМесяца = НачалоМесяца(ТекущаяДата());
КонецМесяца = КонецМесяца(ТекущаяДата());
КоличествоДней = (КонецМесяца - НачалоМесяца + 1) / (60 * 60 * 24);
Сообщить(КоличествоДней);


// =============================================================================
// ЗАДАЧА 13
// Условие:
// Количество дней с начала года.
// Напишите программный код, который вычислит количество дней 
// начиная с начала текущего года до текущей даты.
// =============================================================================

НачалоГода = НачалоГода(ТекущаяДата());
НачалоДня = НачалоДня(ТекущаяДата());
КоличествоДней = (НачалоДня - НачалоГода) / (60 * 60 * 24);
Сообщить(КоличествоДней);

